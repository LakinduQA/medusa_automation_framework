# Copy these values into automaton_framework/.env after running the native Medusa seed.
# The actual customer password belongs only in .env; do not commit it.

# The bundled Medusa 2.16 seed creates these published, stocked products.
TEST_PRODUCT_HANDLE=t-shirt
TEST_PRODUCT_NAME=Medusa T-Shirt
TEST_RELATED_PRODUCT_NAME=Medusa Sweatshirt
TEST_NO_RELATED_PRODUCT_HANDLE=shorts
TEST_FILTER_EXPECTED_PRODUCT_NAMES=Medusa T-Shirt,Medusa Sweatshirt,Medusa Sweatpants,Medusa Shorts
TEST_LATEST_PRODUCT_NAME=Medusa Shorts
TEST_STANDARD_SHIPPING=Standard Shipping
TEST_EXPRESS_SHIPPING=Express Shipping
TEST_STANDARD_SHIPPING_COST=10
TEST_EXPRESS_SHIPPING_COST=10

# Use a unique, non-production address. Set TEST_CUSTOMER_PASSWORD yourself.
TEST_CUSTOMER_EMAIL=playwright.e2e@example.test
TEST_CUSTOMER_PASSWORD=

# This seed supports Denmark, Germany, the UK, Sweden, France, Spain, and Italy.
# Choose one of those countries; Sri Lanka is not part of the seeded Europe region.
TEST_COUNTRY_CODE=dk
TEST_CITY=Copenhagen
TEST_POSTAL_CODE=2100
TEST_ADDRESS_1=1 Playwright Street
